  <script>
    (function(){
      var p = window.location.pathname.replace(/\/+$/, '');
      var langMap = { '/ru': 'ru', '/en': 'en', '/ro': 'en', '/uk': 'ru', '/be': 'ru', '/kk': 'ru' };
      if (p && p !== '') {
        var lang = langMap[p];
        if (lang) localStorage.setItem('sbf_lang', lang);
        window.location.replace('/');
