  <!-- Мгновенное восстановление позиции до первого рендера -->
  <script>
    (function () {
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      /* Восстановление позиции переехало в js/scroll-director.js: здесь
         оно считалось как idx * innerHeight, а секции теперь разной высоты. */
      var idx = 0;
      if (idx > 0) {
        /* Скрываем страницу чтобы не было flash первого блока */
        document.documentElement.style.opacity = '0';
        document.documentElement.style.transition = 'none';
        window.addEventListener('DOMContentLoaded', function () {
          /* Секции 100vh, поэтому offsetTop = idx * innerHeight */
          window.scrollTo(0, idx * window.innerHeight);
          /* Два rAF: первый применяет скролл, второй — показывает */
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              document.documentElement.style.transition = 'opacity 0.2s ease';
              document.documentElement.style.opacity = '1';
            });
          });
        });
      }
    })();
  </script>
