  <!-- ══ STOP P2 — Платформа: PRO-оффер ═══════════════════ -->
  <section class="snap-stop" id="act-platform-2">

    <!-- Верх: заголовок -->
    <div class="p2-header">
      <p class="eyebrow" data-i18n="platform.p2.eyebrow">СТАРТ БЕЗ РИСКА</p>
      <h2 data-i18n="platform.p2.heading">Пройди опрос трейдера — получи 30 дней PRO</h2>
    </div>

    <!-- Три шага — горизонтальная строка над логотипом -->
    <div class="p2-steps">
      <div class="p2-card">
