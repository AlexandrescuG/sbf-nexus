  <!-- ══ LEAD MODAL ════════════════════════════════════════ -->
  <div id="lead-modal" class="lead-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="lead-modal-backdrop"></div>
    <div class="lead-modal-card">
      <button class="lead-modal-close" data-i18n-aria="modal.close_aria" aria-label="Закрыть">×</button>
      <p class="modal-eyebrow" data-i18n="modal.eyebrow">ОСТАВИТЬ ЗАЯВКУ</p>
      <h2 id="modal-title" data-i18n="modal.heading">Наш специалист свяжется с вами в течение часа</h2>
      <form class="lead-form" id="lead-form">
        <label class="field">
          <span class="field-label" data-i18n="modal.name">Имя</span>
          <input type="text" name="name" required minlength="2" autocomplete="given-name">
        </label>
        <label class="field">
          <span class="field-label" data-i18n="modal.email">Email</span>
          <input type="email" name="email" required autocomplete="email" placeholder="you@example.com">
        </label>
        <label class="field">
          <span class="field-label" data-i18n="modal.phone">Телефон — необязательно</span>
          <input type="tel" name="phone" pattern="[+0-9\s\-\(\)]{7,}" placeholder="+373 ..." autocomplete="tel">
        </label>
        <label class="field-checkbox">
          <input type="checkbox" name="gdpr" required>
          <span data-i18n="modal.gdpr">Согласен на обработку персональных данных</span>
        </label>
        <button type="submit" class="lead-submit" disabled data-i18n="modal.submit">ОТПРАВИТЬ ЗАЯВКУ</button>
      </form>
      <div class="lead-divider"><span data-i18n="modal.divider">или напишите напрямую</span></div>
      <a href="https://t.me/SBFAcademy_bot" target="_blank" rel="noopener" class="lead-telegram" data-i18n="modal.tg">
        ✈ НАПИСАТЬ В TELEGRAM
      </a>
      <div class="lead-success hidden">
        <p class="success-icon">✓</p>
        <h3 data-i18n="modal.success_h">Заявка отправлена</h3>
        <p data-i18n="modal.success_p">Мы свяжемся с вами в течение часа</p>
        <a id="lead-book-link" href="#" target="_blank" rel="noopener" class="lead-book-btn" data-i18n="modal.book_btn">📖 Скачать книгу</a>
      </div>
      <div class="lead-error hidden">
        <p><span data-i18n="modal.error_p">Не удалось отправить. Напишите напрямую:</span><br>
        <a href="tel:+37369000520">+373 (69) 000-520</a> ·
        <a href="https://t.me/SBFAcademy_bot">Telegram</a></p>
      </div>
    </div>
  </div>

